{% doc %}
  @prompt
    A heading with an animated glowing effect, I want a "Shop by Color" section with an option where clicking on a color opens up all products in that color.
{% enddoc %}
{% assign ai_gen_id = block.id | replace: '_', '' | downcase %}
{% style %}
  .ai-shop-by-color-{{ ai_gen_id }} { display:block; width:{{ block.settings.desktop_width_percent }}%; max-width:100%; padding:{{ block.settings.vertical_padding }}px {{ block.settings.horizontal_padding }}px; box-sizing:border-box; background:{{ block.settings.background_color }}; color:{{ block.settings.text_color }}; }
  .ai-shop-by-color-{{ ai_gen_id }}__inner { max-width:1200px; margin:0 auto; }
  .ai-shop-by-color-{{ ai_gen_id }}__heading { margin:0 0 28px; color:{{ block.settings.heading_color }}; font-family:{{ block.settings.heading_font.family }}, {{ block.settings.heading_font.fallback_families }}; font-size:{{ block.settings.heading_size }}px; line-height:1.15; text-align:{{ block.settings.alignment }}; }
  .ai-shop-by-color-{{ ai_gen_id }}__grid { display:grid; grid-template-columns:repeat({{ block.settings.columns_desktop }}, minmax(0,1fr)); gap:{{ block.settings.grid_gap }}px; }
  .ai-shop-by-color-{{ ai_gen_id }}__item { display:block; color:{{ block.settings.text_color }}; text-decoration:none; }
  .ai-shop-by-color-{{ ai_gen_id }}__visual { position:relative; aspect-ratio:1; overflow:hidden; border-radius:{{ block.settings.image_radius }}px; background:{{ block.settings.placeholder_color }}; border:1px solid {{ block.settings.border_color }}; }
  .ai-shop-by-color-{{ ai_gen_id }}__visual img { display:block; width:100%; height:100%; object-fit:cover; transition:transform .25s ease; }
  .ai-shop-by-color-{{ ai_gen_id }}__item:hover .ai-shop-by-color-{{ ai_gen_id }}__visual img { transform:scale(1.04); }
  .ai-shop-by-color-{{ ai_gen_id }}__placeholder { display:flex; align-items:center; justify-content:center; width:100%; height:100%; }
  .ai-shop-by-color-{{ ai_gen_id }}__placeholder svg { width:70%; height:70%; opacity:.35; }
  .ai-shop-by-color-{{ ai_gen_id }}__label { display:block; margin-top:12px; font-size:{{ block.settings.label_size }}px; font-weight:600; text-align:center; }
  .ai-shop-by-color-{{ ai_gen_id }}__item:focus-visible { outline:2px solid {{ block.settings.focus_color }}; outline-offset:4px; }
  @media screen and (max-width:749px) { .ai-shop-by-color-{{ ai_gen_id }} { width:100%; padding:{{ block.settings.mobile_vertical_padding }}px {{ block.settings.mobile_horizontal_padding }}px; } .ai-shop-by-color-{{ ai_gen_id }}__grid { grid-template-columns:repeat({{ block.settings.columns_mobile }},minmax(0,1fr)); gap:{{ block.settings.grid_gap | times: 0.75 }}px; } .ai-shop-by-color-{{ ai_gen_id }}__heading { font-size:{{ block.settings.mobile_heading_size }}px; margin-bottom:22px; } }
{% endstyle %}

<shop-by-color-{{ ai_gen_id }} class="ai-shop-by-color-{{ ai_gen_id }}" {{ block.shopify_attributes }}>
  <div class="ai-shop-by-color-{{ ai_gen_id }}__inner">
    {% if block.settings.heading != blank %}<h2 class="ai-shop-by-color-{{ ai_gen_id }}__heading">{{ block.settings.heading | escape }}</h2>{% endif %}
    <div class="ai-shop-by-color-{{ ai_gen_id }}__grid">
      {% for i in (1..6) %}
        {% liquid
          assign collection_key = 'color_' | append: i | append: '_collection'
          assign label_key = 'color_' | append: i | append: '_label'
          assign color_collection = block.settings[collection_key]
          assign color_label = block.settings[label_key]
        %}
        {% if color_collection != blank %}
          <a class="ai-shop-by-color-{{ ai_gen_id }}__item" href="{{ color_collection.url }}" aria-label="Shop {{ color_label | default: color_collection.title | escape }}">
            <div class="ai-shop-by-color-{{ ai_gen_id }}__visual">
              {% if color_collection.featured_image %}
                <img src="{{ color_collection.featured_image | image_url: width: 700 }}" alt="{{ color_collection.featured_image.alt | default: color_collection.title | escape }}" loading="lazy" width="{{ color_collection.featured_image.width }}" height="{{ color_collection.featured_image.height }}">
              {% else %}
                <div class="ai-shop-by-color-{{ ai_gen_id }}__placeholder">{{ 'collection-apparel-1' | placeholder_svg_tag }}</div>
              {% endif %}
            </div>
            <span class="ai-shop-by-color-{{ ai_gen_id }}__label">{{ color_label | default: color_collection.title | escape }}</span>
          </a>
        {% endif %}
      {% endfor %}
    </div>
  </div>
</shop-by-color-{{ ai_gen_id }}>

<script>
  (function() {
    if (!customElements.get('shop-by-color-{{ ai_gen_id }}')) {
      class ShopByColor{{ ai_gen_id }} extends HTMLElement {
        connectedCallback() { this.setAttribute('role', 'region'); }
      }
      customElements.define('shop-by-color-{{ ai_gen_id }}', ShopByColor{{ ai_gen_id }});
    }
  })();
</script>

{% schema %}
{
  "name":"Shop by color",
  "settings":[
    {"type":"header","content":"Content"},
    {"type":"text","id":"heading","label":"Heading","default":"Shop by color"},
    {"type":"header","content":"Color collections"},
    {"type":"collection","id":"color_1_collection","label":"Color 1 collection"},
    {"type":"text","id":"color_1_label","label":"Color 1 label","default":"Black"},
    {"type":"collection","id":"color_2_collection","label":"Color 2 collection"},
    {"type":"text","id":"color_2_label","label":"Color 2 label","default":"White"},
    {"type":"collection","id":"color_3_collection","label":"Color 3 collection"},
    {"type":"text","id":"color_3_label","label":"Color 3 label","default":"Navy"},
    {"type":"collection","id":"color_4_collection","label":"Color 4 collection"},
    {"type":"text","id":"color_4_label","label":"Color 4 label","default":"Grey"},
    {"type":"collection","id":"color_5_collection","label":"Color 5 collection"},
    {"type":"text","id":"color_5_label","label":"Color 5 label","default":"Red"},
    {"type":"collection","id":"color_6_collection","label":"Color 6 collection"},
    {"type":"text","id":"color_6_label","label":"Color 6 label","default":"Green"},
    {"type":"header","content":"Layout"},
    {"type":"range","id":"desktop_width_percent","label":"Desktop width","min":50,"max":100,"step":5,"unit":"%","default":100},
    {"type":"select","id":"columns_desktop","label":"Columns on desktop","options":[{"value":"3","label":"3"},{"value":"4","label":"4"},{"value":"6","label":"6"}],"default":"6"},
    {"type":"select","id":"columns_mobile","label":"Columns on mobile","options":[{"value":"1","label":"1"},{"value":"2","label":"2"}],"default":"2"},
    {"type":"range","id":"grid_gap","label":"Grid gap","min":8,"max":40,"step":4,"unit":"px","default":20},
    {"type":"range","id":"vertical_padding","label":"Desktop vertical space","min":0,"max":80,"step":4,"unit":"px","default":32},
    {"type":"range","id":"horizontal_padding","label":"Desktop horizontal space","min":0,"max":80,"step":4,"unit":"px","default":24},
    {"type":"range","id":"mobile_vertical_padding","label":"Mobile vertical space","min":0,"max":48,"step":4,"unit":"px","default":24},
    {"type":"range","id":"mobile_horizontal_padding","label":"Mobile horizontal space","min":0,"max":40,"step":4,"unit":"px","default":16},
    {"type":"header","content":"Style"},
    {"type":"font_picker","id":"heading_font","label":"Heading font","default":"geist_n6"},
    {"type":"range","id":"heading_size","label":"Heading size","min":20,"max":64,"step":4,"unit":"px","default":32},
    {"type":"range","id":"mobile_heading_size","label":"Mobile heading size","min":18,"max":40,"step":2,"unit":"px","default":26},
    {"type":"range","id":"label_size","label":"Label size","min":12,"max":24,"step":2,"unit":"px","default":14},
    {"type":"range","id":"image_radius","label":"Image radius","min":0,"max":24,"step":2,"unit":"px","default":2},
    {"type":"select","id":"alignment","label":"Heading alignment","options":[{"value":"left","label":"Left"},{"value":"center","label":"Center"}],"default":"left"},
    {"type":"color","id":"background_color","label":"Background","default":"#FFFFFF"},
    {"type":"color","id":"heading_color","label":"Heading","default":"#030302"},
    {"type":"color","id":"text_color","label":"Text","default":"#030302"},
    {"type":"color","id":"border_color","label":"Border","default":"#D3CEC5"},
    {"type":"color","id":"placeholder_color","label":"Placeholder","default":"#EDEBE7"},
    {"type":"color","id":"focus_color","label":"Focus outline","default":"#030302"}
  ],
  "presets":[{"name":"Shop by color"}],
  "tag":null,
  "class":"shop-by-color-block"
}
{% endschema %}