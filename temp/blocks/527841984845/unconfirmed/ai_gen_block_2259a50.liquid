{% doc %}
  @prompt
    A heading with an animated glowing effect
{% enddoc %}
{% assign ai_gen_id = block.id | replace: '_', '' | downcase %}
{% style %}
  .ai-glowing-heading-{{ ai_gen_id }} { display: block; width: {{ block.settings.desktop_width_percent }}%; max-width: 100%; padding: {{ block.settings.vertical_padding }}px {{ block.settings.horizontal_padding }}px; text-align: {{ block.settings.alignment }}; box-sizing: border-box; }
  .ai-glowing-heading-{{ ai_gen_id }}__text { display: inline-block; margin: 0; color: {{ block.settings.text_color }}; font-family: {{ block.settings.heading_font.family }}, {{ block.settings.heading_font.fallback_families }}; font-size: {{ block.settings.heading_size }}px; font-weight: {{ block.settings.font_weight }}; line-height: 1.1; letter-spacing: {{ block.settings.letter_spacing }}px; text-transform: {{ block.settings.text_case }}; }
  .ai-glowing-heading-{{ ai_gen_id }}__text--glowing { animation: ai-glowing-heading-pulse-{{ ai_gen_id }} {{ block.settings.animation_speed }}s ease-in-out infinite alternate; }
  @keyframes ai-glowing-heading-pulse-{{ ai_gen_id }} { from { text-shadow: 0 0 {{ block.settings.glow_size }}px {{ block.settings.glow_color }}; } to { text-shadow: 0 0 {{ block.settings.glow_size | times: 2 }}px {{ block.settings.glow_color }}, 0 0 {{ block.settings.glow_size | times: 4 }}px {{ block.settings.glow_color }}; } }
  @media screen and (max-width: 749px) { .ai-glowing-heading-{{ ai_gen_id }} { width: 100%; padding: {{ block.settings.mobile_vertical_padding }}px {{ block.settings.mobile_horizontal_padding }}px; } .ai-glowing-heading-{{ ai_gen_id }}__text { font-size: {{ block.settings.mobile_heading_size }}px; } }
  @media (prefers-reduced-motion: reduce) { .ai-glowing-heading-{{ ai_gen_id }}__text--glowing { animation: none; text-shadow: 0 0 {{ block.settings.glow_size }}px {{ block.settings.glow_color }}; } }
{% endstyle %}
<glowing-heading-{{ ai_gen_id }} class="ai-glowing-heading-{{ ai_gen_id }}" {{ block.shopify_attributes }}><h2 class="ai-glowing-heading-{{ ai_gen_id }}__text{% if block.settings.enable_glow %} ai-glowing-heading-{{ ai_gen_id }}__text--glowing{% endif %}">{{ block.settings.heading | escape }}</h2></glowing-heading-{{ ai_gen_id }}>
<script>(function(){if(!customElements.get('glowing-heading-{{ ai_gen_id }}')){class GlowingHeading{{ ai_gen_id }} extends HTMLElement{connectedCallback(){this.setAttribute('role','region');}}customElements.define('glowing-heading-{{ ai_gen_id }}',GlowingHeading{{ ai_gen_id }});}})();</script>
{% schema %}
{
  "name": "Glowing heading",
  "settings": [
    {"type":"header","content":"Content"},
    {"type":"text","id":"heading","label":"Heading","default":"Move with purpose"},
    {"type":"checkbox","id":"enable_glow","label":"Enable glow","default":true},
    {"type":"header","content":"Typography"},
    {"type":"font_picker","id":"heading_font","label":"Font","default":"geist_n6"},
    {"type":"range","id":"heading_size","label":"Desktop size","min":20,"max":120,"step":4,"unit":"px","default":56},
    {"type":"range","id":"mobile_heading_size","label":"Mobile size","min":18,"max":64,"step":2,"unit":"px","default":36},
    {"type":"range","id":"font_weight","label":"Weight","min":400,"max":800,"step":100,"default":600},
    {"type":"range","id":"letter_spacing","label":"Letter spacing","min":-2,"max":6,"step":1,"unit":"px","default":0},
    {"type":"select","id":"text_case","label":"Text case","options":[{"value":"none","label":"Default"},{"value":"uppercase","label":"Uppercase"}],"default":"none"},
    {"type":"select","id":"alignment","label":"Alignment","options":[{"value":"left","label":"Left"},{"value":"center","label":"Center"},{"value":"right","label":"Right"}],"default":"left"},
    {"type":"header","content":"Glow"},
    {"type":"color","id":"text_color","label":"Text","default":"#030302"},
    {"type":"color","id":"glow_color","label":"Glow","default":"#713F50"},
    {"type":"range","id":"glow_size","label":"Glow size","min":2,"max":20,"step":2,"unit":"px","default":8},
    {"type":"range","id":"animation_speed","label":"Pulse speed","min":1,"max":8,"step":1,"unit":"s","default":3},
    {"type":"range","id":"desktop_width_percent","label":"Desktop width","min":50,"max":100,"step":5,"unit":"%","default":100},
    {"type":"range","id":"vertical_padding","label":"Desktop vertical space","min":0,"max":80,"step":4,"unit":"px","default":24},
    {"type":"range","id":"horizontal_padding","label":"Desktop horizontal space","min":0,"max":80,"step":4,"unit":"px","default":24},
    {"type":"range","id":"mobile_vertical_padding","label":"Mobile vertical space","min":0,"max":48,"step":4,"unit":"px","default":16},
    {"type":"range","id":"mobile_horizontal_padding","label":"Mobile horizontal space","min":0,"max":40,"step":4,"unit":"px","default":16}
  ],
  "presets":[{"name":"Glowing heading"}],
  "tag":null,
  "class":"glowing-heading-block"
}
{% endschema %}